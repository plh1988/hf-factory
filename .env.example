# The ONE setting that differs between local and cloud.
#   memory          everything in memory, Vertex AI for text and embeddings
#   memory-offline  everything in memory, deterministic fake LLM (no GCP needed; used by tests)
#   memory-local    everything in memory, local LLM via an OpenAI-compatible API (LM Studio, Ollama)
#   gcp             AlloyDB, BigQuery, Cloud Storage, Vector Search, Pub/Sub, Vertex AI
FACTORY_PROFILE=memory-offline

# Agentic capability layer: stage payloads that ask for unknown entities or use cases start a capability build
# (202 CAPABILITY_BUILD_STARTED) instead of a 4xx. Published capability packs work either way.
FACTORY_CAPABILITY_LAYER=false

# Who builds the packs for a build: agents (the profile's LLM with the capability skill), manual (publish by hand),
# or auto (agents unless the LLM is the offline stand-in).
FACTORY_CAPABILITY_BUILDER=auto
# Capability skill folder (default: skills/healthcare-capability-builder in the repository).
# FACTORY_SKILL_DIR=
