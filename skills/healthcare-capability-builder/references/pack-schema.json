    "Choice": {
      "additionalProperties": false,
      "description": "One of `options`, weighted by `weights` (uniform when omitted). Options are listed explicitly, in order.",
      "properties": {
        "op": {
          "const": "choice",
          "title": "Op",
          "type": "string"
        },
        "draw": {
          "description": "draw name: the random value is fixed by (seed, stream, row key, draw)",
          "pattern": "^[a-z][a-z0-9_:]*$",
          "title": "Draw",
          "type": "string"
        },
        "options": {
          "items": {},
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "weights": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        }
      },
      "required": [
        "op",
        "draw",
        "options"
      ],
      "title": "Choice",
      "type": "object"
    },
